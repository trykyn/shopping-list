rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Jede Person merkt sich hier, zu welchem Haushalt sie gehört. / 각 사용자가 속한 집을 기억.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Der Dokumentname ist der Einladungscode: wer angemeldet ist und ihn kennt, darf lesen und schreiben.
    // Auflisten und Löschen sind nicht erlaubt, also lässt sich kein Code erraten oder durchsuchen.
    // 문서 이름이 초대 코드. 로그인했고 코드를 아는 사람만 읽고 쓸 수 있음. 목록 조회·삭제는 불가.
    match /households/{code} {
      allow get, create, update: if request.auth != null;
    }
  }
}
